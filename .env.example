# =============================================================================
# DeepSeekHarness — переменные окружения.
#
# Скопируйте этот файл в .env и заполните:  cp .env.example .env
#
# .env читают две вещи:
#   * Makefile      — параметры `make sync` (VDS_*, SSH_KEY, SYNC_EXCLUDES);
#   * Docker Compose — подстановка ${...} в docker-compose*.yml.
#
# В git, в контекст сборки образа и в rsync на VDS файл не попадает.
# Значения пишите без кавычек; комментарии — отдельной строкой; в секретах и
# путях избегайте пробелов, `#` и `$` — Make и Compose прочитают их по-разному.
# =============================================================================

# --- Перенос на VDS (make sync) ----------------------------------------------

# Хост или IP удалённого сервера, куда переносится окружение.
VDS_HOST=

# SSH-пользователь на VDS (должен уметь docker и писать в VDS_DIR).
VDS_USER=root

# SSH-порт сервера.
VDS_PORT=22

# Каталог, в который на VDS склонирован репозиторий (туда `make sync`
# складывает состояние в data/). Создаётся при первом `make sync`.
VDS_DIR=/srv/deepseek-harness

# Приватный SSH-ключ для ssh/rsync (полный путь). Пусто — ключи по умолчанию.
SSH_KEY=

# Дополнительные исключения rsync через пробел (например: .idea .vscode).
# node_modules с Mac лучше не тащить на Linux-сервер: нативные модули
# (node-pty и т.п.) собраны под macOS и сломают профиль на VDS. Если профиль
# там уже установлен, раскомментируйте (это ещё и 355 МБ из 373 МБ синка):
#   SYNC_EXCLUDES=node_modules
SYNC_EXCLUDES=

# Флаги rsync. Старый macOS-rsync (2.6.9) не знает --info=progress2 —
# тогда поставьте -aH -v.
RSYNC_FLAGS=-aH --info=progress2

# --- Права на data/ (важно для make sync) ------------------------------------

# UID/GID, от которого работает контейнер и которому принадлежат файлы в data/
# (см. Dockerfile). Должны совпадать с пользователем, под которым вы делаете
# `make sync` на VDS: проверьте там `id -u` и `id -g`. Если контейнер пишет от
# root, новые сессии и attachments на хосте становятся root:root, а rsync под
# обычным пользователем падает с Permission denied / failed to set times.
# 1000 — типичный первый пользователь Ubuntu/Debian. После изменения значений
# образ надо пересобрать: docker compose up -d --build.
DSH_UID=1000
DSH_GID=1000

# --- Порты и доступ ----------------------------------------------------------

# Порт DSH внутри контейнера (менять не нужно).
DSH_PORT=3079

# Порт встроенного прокси: он же публикуется на хост.
PROXY_PORT=3080

# Интерфейс, на котором публикуется прокси:
#   127.0.0.1 — только с самого хоста (VDS за TLS-прокси или SSH-туннелем);
#   0.0.0.0   — вся сеть, в т.ч. LAN (например, Mac в домашней сети).
PROXY_BIND=127.0.0.1

# --- Модель и плагины --------------------------------------------------------

# Модель агента по умолчанию.
DSH_MODEL=deepseek-chat

# Git-репозиторий community-плагинов (клон живёт в data/dsh-plugins).
DSH_PLUGINS_REPO=https://github.com/steve-magne/dsh-plugins

# Коммит/тег, на который контейнер встаёт при старте (не ветка main).
DSH_PLUGINS_REF=ac8dbb67e8cc4d252bfdfaf69078de1de0a5613a

# --- Секреты -----------------------------------------------------------------

# API-ключ провайдера (DeepSeek, OpenRouter или OpenAI).
OPENAI_API_KEY=

# Логин Basic Auth для Web UI. Задавайте пару обязательно: без неё прокси
# на PROXY_PORT пускает кого угодно без пароля.
PROXY_USERNAME=

# Пароль Basic Auth (сильный). Без пары PROXY_USERNAME/PROXY_PASSWORD любой,
# кто дотянется до PROXY_PORT, получит сессию агента с шеллом в контейнере.
PROXY_PASSWORD=

# Personal access token GitHub (repo/read:org) для gh и сайдбар-плагинов.
GH_TOKEN=

# Personal access token GitLab для glab.
GITLAB_TOKEN=

# --- Пути на хосте (bind-mount'ы) --------------------------------------------

# Папка, которую агент видит как /opt/workspace (код, над которым работает).
WORKSPACE_DIR=./workspace

# Где хранятся логины gh/glab вне контейнера (переживают пересоздание).
GH_CONFIG_DIR=./data/gh-config
GLAB_CONFIG_DIR=./data/glab-config

# Путь к git-конфигу внутри контейнера. По умолчанию он лежит в /root/.dsh —
# единственном месте, которое переживает пересоздание контейнера (туда
# `gh auth login` кладёт credential helper для git).
GIT_CONFIG_GLOBAL=/root/.dsh/gitconfig

# Каталог с SSH-ключами для git по SSH (полный путь). Нужен только если
# раскомментировать монтирование /root/.ssh в docker-compose.override.yml.
SSH_DIR=

# Сокет ssh-agent хоста — только если ключ под паролем. Нужен только вместе
# с монтированием /ssh-agent в docker-compose.override.yml.
SSH_AUTH_SOCK_PATH=

# Доп. проекты агента: задайте пути, если монтируете их в override.
PROJECT_HLRD_DIR=
PROJECT_DATING_DIR=
