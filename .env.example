# Скопируйте в .env и заполните реальными значениями.
# .env в git не попадает (см. .gitignore) — секреты сюда, не в docker-compose.yml.

# Ключ провайдера модели (DeepSeek, OpenRouter или OpenAI)
OPENAI_API_KEY=sk-xxxx

# Базовая авторизация Web UI (опционально, см. закомментированные строки в docker-compose.yml)
#PROXY_USERNAME=admin
#PROXY_PASSWORD=admin

# Personal access token для gh (репо/приватные репозитории): GitHub → Settings →
# Developer settings → Personal access tokens. Достаточно прав repo/read:org.
# gh подхватывает GH_TOKEN сам, без интерактивного `gh auth login`.
GH_TOKEN=

# Personal access token для glab: GitLab → Preferences → Access Tokens.
GITLAB_TOKEN=
