# Persistent runtime-данные DSH (сессии, чаты, credentials, node_modules плагинов,
# кэш Chromium) — это состояние контейнера, а не часть проекта, и весит сотни МБ
data/

# Папка, которую docker-compose.override.yml монтирует агенту как /opt/workspace
# (README, раздел «Структура»): там лежит код проектов, часто чужие git-репозитории
workspace/

# Состояние DSH внутри самого репозитория: рабочие каталоги агента
# (.dsh/worktrees/<сессия> — отдельный checkout этого же репозитория) и прочее
.dsh/

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Секреты (API-ключи, токены gh/glab, Basic Auth), пути и порты этой машины —
# реальные значения только в .env, в git не попадают. Шаблон: .env.example
.env

# Необязательные машинные дополнения к docker-compose.yml (ключи/ssh-agent,
# лишние проекты, extra_hosts). Шаблон: docker-compose.override.example.yml
docker-compose.override.yml
